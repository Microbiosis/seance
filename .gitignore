__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# model weights and data are never committed
*.safetensors
*.gguf
*.bin
data/
models/

# ...except the small assets the demo Space needs.  They ship in packed form
# (manifest.json + parts): the machine that uploads this repo can only carry
# ~12 KB per request, so every asset is gzipped and split.
!app/assets/manifest.json
!app/assets/*.p[0-9][0-9][0-9]

# the unpacked intermediate (regenerated by scripts/rebuild.py)
app/_assets/

# The full audit result and the ghost's atlas ship packed with the assets
# (app/assets/audit.p*, app/assets/atlas.p*) so the demo Space can carry them.
# The originals are committed as well -- the post quotes them, so a reader
# has to be able to open them.
!results/audit.json
!results/atlas.json

# a partial run kept while the metric was being settled; not part of the record
results/audit_partial.json

# streamlit
.streamlit/secrets.toml

# Space staging directory (rebuilt by scripts/deploy_space.py)
space/

# scratch files written by the upload helpers
.pushlog.txt
.stage.json
.preupload.json
.lfs_batch.json
.commit.ndjson
.lfs_payload.bin
.bigcommit.ndjson
.commit_test.ndjson
.commit_test.out
.pre_one.json
hf_commits.json
hf_models.json
space_info.json
space_info2.json

.DS_Store
Thumbs.db

# scratch files written by the REST uploader
.upload_cache.json
.upload_body.json
.upload_body.json.out
.tree_body.json
.push_body.json
.push_body.json.out
.commit.out
